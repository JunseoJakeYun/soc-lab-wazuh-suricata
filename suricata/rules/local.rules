# ============================================================
# SOC LAB - Custom Suricata Detection Rules
# Location : SOC-IDS-01 /var/lib/suricata/rules/local.rules
# ============================================================
#
# Purpose:
# This file contains custom Suricata IDS rules created for
# the SOC lab. These rules are designed to detect suspicious
# network activity by making several basic traffic 
# and generate alerts for investigation through the Wazuh SIEM.
#
# Detection rules included:
# 1. ICMP Echo Request Detection
# 2. Possible HTTP request with including 'admin' 
# 3. Possible TCP Port Scan Detection
# 4. Possible SSH Brute Force / Repeated Connection Attempts
#
# Alert flow:
# Network Traffic -> Suricata IDS -> Wazuh Agent
# -> Wazuh Manager -> Wazuh Dashboard
#
# ============================================================


# Detect ICMP echo requests (ping)
alert icmp any any -> $HOME_NET any (
    msg:"SOC LAB - ICMP Echo Request Detected";
    sid:1000001;
    rev:1;
)

# Detect Http traffic with "admin" 
alert http any any -> $HOME_NET any (
    msg:"SOC LAB - Suspicious HTTP Admin Path";    
    http.uri; content:"/admin"; 
    sid:1000002; 
    rev:1;
)


# Detect possible TCP port scanning activity by identifying
# repeated TCP SYN packets from the same source within 10 seconds.
alert tcp any any -> $HOME_NET any (
    msg:"SOC LAB - Possible TCP Port Scan"; 
    flags:S; 
    threshold:type both, track by_src, count 20, seconds 10; 
    sid:1000003; 
    rev:1;
)

# Detect possible SSH brute-force or repeated login attempts
# by identifying multiple TCP connection attempts to SSH (port 22)
# from the same source within 60 seconds.
# More test required on how Suricata count SSH request
alert tcp any any -> $HOME_NET 22 (
    msg:"SOC LAB - Possible SSH Brute Force / Repeated Login Attempts"; 
    flags:S; 
    threshold:type both, track by_src, count 2, seconds 60; 
    sid:1000004; 
    rev:1;
)
